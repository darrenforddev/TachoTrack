{
  "expo": {
    "name": "TachoTrack",
    "slug": "TachoTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/tachotrack-app-icon.png",
    "scheme": "tachotrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/tachotrack-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/branding/tachotrack-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/tachotrack-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/branding/tachotrack-splash-logo.png",
          "imageWidth": 320
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
